   "y": 1.5,
   "w": 5.3,
   "h": 0.25333333333333335,
   "text": "uᵣ = −(r/2) ∂_z v,   τ_zz = 2μ ∂_z v,   τᵣᵣ = −μ ∂_z v",
   "font": "Arial",
   "font_size": 12,
