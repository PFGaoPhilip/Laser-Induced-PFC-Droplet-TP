  },
  {
   "x": 0.5,
   "y": 1.05,
   "w": 12.3,
   "h": 0.2872222222222222,
   "text": "Regular polygons of N bubbles, neighbouring distance s",
   "font": "Arial",
   "font_size": 14,
   "color": "#8EDBD4",
   "word_wrap": false,
   "align": "left",
   "valign": "top",
   "margin": 0.02,
   "bold": true,
   "type": "text",
   "id": "o029",
   "name": "C3-E06 text 29"
  },
  {
   "x": 0.5,
   "y": 1.5,
   "w": 12.3,
   "h": 0.2872222222222222,
   "text": "dₖ = s sin(kπ/N) / sin(π/N),   S_N = Σₖ₌₁^{N−1} 1/dₖ",
   "font": "Arial",
   "font_size": 14,
   "color": "#E7F0F3",
   "word_wrap": false,
   "align": "left",
   "valign": "top",
   "margin": 0.02,
   "bold": true,
   "type": "text",
   "id": "o030",
   "name": "C3-E06 text 30"
  },
  {
   "x": 0.5,
   "y": 6.0,
   "w": 12.3,
   "h": 0.27875,
   "text": "S₃ = 2/s,   S₄ = (2 + 1/√2)/s,   S₅ = (2 + 2/φ)/s,   φ = (1 + √5)/2",
   "font": "Arial",
   "font_size": 13.5,
   "color": "#E7F0F3",
   "word_wrap": false,
   "align": "left",
   "valign": "top",
   "margin": 0.02,
   "type": "text",
   "id": "o031",
   "name": "C3-E06 text 31"
  },
  {
   "x": 0.5,
   "y": 6.5,
   "w": 12.3,
   "h": 0.26180555555555557,
   "text": "Every bubble sees the same sum of reciprocal distances, so they can share one radius history in this constrained control.",
   "font": "Arial",
   "font_size": 12.5,
   "color": "#F2B880",
   "word_wrap": false,
   "align": "left",
   "valign": "top",
