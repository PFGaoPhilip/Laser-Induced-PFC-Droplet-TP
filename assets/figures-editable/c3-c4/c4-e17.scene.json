   "type": "text",
   "id": "o044",
   "name": "C4-E17 text 44"
  },
  {
   "x": 7.65,
   "y": 2.55,
   "w": 5.2,
   "h": 0.24486111111111108,
   "text": "𝓛ᵣ w ∝ −8 + 16 r²,  𝓛ᵣ²w ∝ 64  ⇒  D_f 𝓛ᵣ²w = p₀",
   "font": "Arial",
   "font_size": 11.5,
   "color": "#E7F0F3",
   "word_wrap": false,
