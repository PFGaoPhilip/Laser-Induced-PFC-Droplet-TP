   "x": 7.65,
   "y": 3.1,
   "w": 5.2,
   "h": 0.26180555555555557,
   "text": "w′(r) = p₀ r (r² − b²) / (16D_f)",
   "font": "Arial",
   "font_size": 12.5,
   "color": "#F2B880",
   "word_wrap": false,
