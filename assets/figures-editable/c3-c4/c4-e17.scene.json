  {
   "x": 7.65,
   "y": 2.0,
   "w": 5.2,
   "h": 0.26180555555555557,
   "text": "𝓛ᵣ(r²) = 4,   𝓛ᵣ(r⁴) = 16 r²",
   "font": "Arial",
   "font_size": 12.5,
   "color": "#E7F0F3",
   "word_wrap": false,
   "align": "left",
   "valign": "top",
   "margin": 0.02,
