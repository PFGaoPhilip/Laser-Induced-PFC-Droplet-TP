  },
  {
   "x": 7.85,
   "y": 2.0,
   "w": 5.0,
   "h": 0.26180555555555557,
   "text": "pₑₗ(R_ref) = (G_g/2)(5 − 4 − 1) = 0",
   "font": "Arial",
   "font_size": 12.5,
   "color": "#E7F0F3",
   "word_wrap": false,
   "align": "left",
   "valign": "top",
   "margin": 0.02,
   "bold": true,
   "type": "text",
   "id": "o042",
   "name": "A-E06 text 42"
  },
  {
   "x": 7.85,
   "y": 2.6,
   "w": 5.0,
   "h": 0.25333333333333335,
   "text": "dpₑₗ/dR = 2G_g (R_ref/R² + R_ref⁴/R⁵) > 0",
   "font": "Arial",
   "font_size": 12,
   "color": "#E7F0F3",
   "word_wrap": false,
   "align": "left",
   "valign": "top",
   "margin": 0.02,
   "bold": true,
   "type": "text",
   "id": "o043",
   "name": "A-E06 text 43"
  },
  {
   "x": 7.85,
   "y": 3.2,
   "w": 5.0,
   "h": 0.26180555555555557,
   "text": "lim R/R_ref → ∞: pₑₗ → 5G_g/2",
   "font": "Arial",
   "font_size": 12.5,
   "color": "#E7F0F3",
   "word_wrap": false,
   "align": "left",
   "valign": "top",
   "margin": 0.02,
   "bold": true,
   "type": "text",
   "id": "o044",
   "name": "A-E06 text 44"
  },
  {
   "x": 7.85,
   "y": 3.9,
   "w": 5.0,
   "h": 0.45666666666666667,
   "text": "Zero strain, zero resistance; expansion raises it\nmonotonically and boundedly.",
   "font": "Arial",
   "font_size": 12,
   "color": "#B4C7D2",
   "word_wrap": false,
   "align": "left",
   "valign": "top",
   "margin": 0.02,
   "type": "text",
   "id": "o045",
   "name": "A-E06 text 45"
  },
  {
