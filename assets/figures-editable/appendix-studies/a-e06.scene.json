   "y": 6.27,
   "w": 12,
   "h": 0.26180555555555557,
   "text": "These checks guard against sign errors: a negative slope or a non-zero value at R_ref would signal a mistake.",
   "font": "Arial",
   "font_size": 12.5,
   "color": "#E7F0F3",
   "word_wrap": false,
