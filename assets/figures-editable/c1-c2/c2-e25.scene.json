  {
   "x": 9.07,
   "y": 2.85,
   "w": 3.78,
   "h": 0.45666666666666667,
   "text": "Evaporation raises p; cooling lowers it;\nvolume growth lowers it quickly.",
   "font": "Arial",
   "font_size": 12,
   "color": "#E7F0F3",
   "word_wrap": false,
   "align": "left",
   "valign": "top",
