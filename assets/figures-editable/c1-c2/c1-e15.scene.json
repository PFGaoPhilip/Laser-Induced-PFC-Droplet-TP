  },
  {
   "x": 8.270000000000001,
   "y": 3.273611111111111,
   "w": 4.58,
   "h": 0.4736111111111111,
   "text": "The minus sign selects the inward branch\n(collapse).",
   "font": "Arial",
   "font_size": 12.5,
   "color": "#E7F0F3",
   "word_wrap": false,
   "align": "left",
   "valign": "top",
