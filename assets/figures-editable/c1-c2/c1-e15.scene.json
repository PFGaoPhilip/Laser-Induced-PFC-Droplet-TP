   "y": 3.7972222222222216,
   "w": 4.58,
   "h": 0.4736111111111111,
   "text": "As R → 0, |Ṙ| grows without bound: this is the\nmodel's singularity, not a physical speed limit.",
   "font": "Arial",
   "font_size": 12.5,
   "color": "#E7F0F3",
   "word_wrap": false,
   "align": "left",
   "valign": "top",
