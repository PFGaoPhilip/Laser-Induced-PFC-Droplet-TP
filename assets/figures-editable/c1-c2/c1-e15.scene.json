   "y": 2.0,
   "w": 4.8,
   "h": 0.2702777777777778,
   "text": "Ṙ = −√{ (2Δp_c/3ρ) [ (Rₘₐₓ/R)³ − 1 ] }",
   "font": "Arial",
   "font_size": 13,
   "color": "#E7F0F3",
   "word_wrap": false,
   "align": "left",
   "valign": "top",
   "margin": 0.02,
   "bold": true,
   "type": "text",
   "id": "o042",
   "name": "C1-E15 text 42"
  },
  {
   "x": 8.270000000000001,
   "y": 2.75,
   "w": 4.58,
   "h": 0.4736111111111111,
   "text": "The start R = Rₘₐₓ at rest fixes the constant: Ṙ\n= 0 there.",
   "font": "Arial",
   "font_size": 12.5,
   "color": "#E7F0F3",
   "word_wrap": false,
   "align": "left",
   "valign": "top",
   "margin": 0.02,
   "type": "text",
   "id": "o043",
   "name": "C1-E15 text 43"
  },
