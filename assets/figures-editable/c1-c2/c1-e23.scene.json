  },
  {
   "x": 7.65,
   "y": 5.07,
   "w": 5.1,
   "h": 0.2702777777777778,
   "text": "Conditions: Uτ/L ≪ 1 and ντ/L² ≪ 1.",
   "font": "Arial",
   "font_size": 13,
   "color": "#E7F0F3",
   "word_wrap": false,
   "align": "left",
   "valign": "top",
   "margin": 0.02,
   "bold": true,
   "type": "text",
   "id": "o030",
   "name": "C1-E23 text 30"
  },
  {
   "x": 7.65,
   "y": 5.5,
   "w": 5.1,
   "h": 0.6854166666666667,
   "text": "Result: the velocity right after the pulse depends on\nthe shape of the liquid region, not on a detailed\npressure history.",
   "font": "Arial",
   "font_size": 12.5,
   "color": "#F2B880",
   "word_wrap": false,
