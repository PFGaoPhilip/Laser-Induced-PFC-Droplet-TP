  },
  {
   "x": 8.870000000000001,
   "y": 3.2118055555555554,
   "w": 3.98,
   "h": 0.4736111111111111,
   "text": "It gives the equilibrium vapor pressure of\nbulk liquid.",
   "font": "Arial",
   "font_size": 12.5,
   "color": "#E7F0F3",
   "word_wrap": false,
   "align": "left",
   "valign": "top",
