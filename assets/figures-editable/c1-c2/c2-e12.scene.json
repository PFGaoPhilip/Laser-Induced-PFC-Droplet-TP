   "y": 2.0,
   "w": 4.2,
   "h": 0.4736111111111111,
   "text": "log₁₀(p/10⁵ Pa) = 4.2063 − 1103.454 K/(T −\n39.77 K)",
   "font": "Arial",
   "font_size": 12.5,
   "color": "#E7F0F3",
   "word_wrap": false,
   "align": "left",
   "valign": "top",
   "margin": 0.02,
   "bold": true,
   "type": "text",
   "id": "o045",
   "name": "C2-E12 text 45"
  },
  {
   "x": 8.870000000000001,
   "y": 2.9,
   "w": 3.98,
   "h": 0.26180555555555557,
   "text": "Valid only for 282.82 K ≤ T ≤ 337.94 K.",
   "font": "Arial",
   "font_size": 12.5,
   "color": "#E7F0F3",
   "word_wrap": false,
   "align": "left",
   "valign": "top",
   "margin": 0.02,
